# MicroVerse configuration. Copy to .env for local use, or paste into the host's
# environment-variable settings. Every value here has a default that runs MicroVerse
# exactly as it has always run, so an empty environment is a working environment.
#
# Nothing in this file is a secret. Do not commit the filled-in version.

# --- where a job's bytes live ------------------------------------------------
# "local" (default) writes to data/jobs/<token>/, which is what a server with a disk
# should keep doing. "blob" stores them in Vercel Blob, for a host whose filesystem
# does not outlive the request.
MICROVERSE_STORAGE=local

# --- how an analysis is started ----------------------------------------------
# "inline" (default) runs it in Starlette's background threadpool. "queue" publishes
# the token to Vercel Queues, delivered to the subscriber in app/queue_worker.py —
# required on a host that freezes the process once the response is sent.
MICROVERSE_JOBS=inline

# --- the job database ---------------------------------------------------------
# Defaults to SQLite beside the data directory. A host without a durable disk needs a
# networked database instead; any SQLAlchemy URL works.
#   Neon:  postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
# MICROVERSE_DB=

# Result objects readable by URL alone. "private" (default) keeps every read behind
# the store credential, so the app streams downloads and the host's response cap
# applies. "public" lets the browser fetch a result directly from an unguessable URL,
# which is the only way past that cap with the Python SDK — and a different promise
# about the data, so it is opt-in.
MICROVERSE_BLOB_ACCESS=private

# Route that mints a browser upload token. Only the JavaScript SDK can sign these,
# so this points at api/blob-upload.js, not at anything in the Python app. Empty
# disables direct upload and the browser posts the form instead.
MICROVERSE_BLOB_HANDLER=/api/blob-upload
# The same service answers GET /api/blob-download: private results larger than a
# function may return (the bundle and long results) are served as a short-lived
# signed URL, never streamed through the app. Nothing to set; it needs the three
# values below -- MICROVERSE_BACKEND_URL, MICROVERSE_WORKER_SECRET and
# BLOB_READ_WRITE_TOKEN -- and answers 500 naming whichever is missing.

# --- secrets the host provides ------------------------------------------------
# Vercel sets these for you when the Blob store and Queues are attached to the
# project. They are listed here so the required set is visible in one place.
# BLOB_READ_WRITE_TOKEN=     (Blob store, attached to the project)
# VERCEL_OIDC_TOKEN=         (Queues auth; resolved automatically on Vercel)
# VERCEL_DEPLOYMENT_ID=      (set by Vercel; queue messages are partitioned by it)
# VERCEL_REGION=             (set by Vercel; send and consume must share a region)

# Shared secret between the app and the Blob signing service (blob/api/blob-upload.js).
# It also signs upload tickets, so every instance must see the same value.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MICROVERSE_WORKER_SECRET=
# Where api/blob-upload.js reaches this application to check a ticket. On Vercel the
# two are one deployment, so the deployment's own URL.
# MICROVERSE_BACKEND_URL=

# --- optional tuning ----------------------------------------------------------
# Seconds a signed download link stays valid (default 900).
# MICROVERSE_DOWNLOAD_TTL=900
# Seconds a browser has to finish uploading one file (default 1800).
# MICROVERSE_UPLOAD_TTL=1800
# Seconds an undelivered run request stays claimable (default 21600).
# MICROVERSE_QUEUE_TTL=21600
# Days results are kept — SPEC 16.5 says 90.
# MICROVERSE_RETENTION_DAYS=90
# Largest upload accepted, in bytes (default 67108864 = 64 MB).
# MICROVERSE_MAX_UPLOAD=67108864
# Concurrent analyses allowed. On a queue backend this is the consumer concurrency,
# which is global; on the inline backend it is per process.
# MICROVERSE_MAX_CONCURRENT=4
# The "Source" link in the header and footer.
# MICROVERSE_REPO=https://github.com/prince-raveled/STATA-Cluster
