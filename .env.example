# MicroVerse configuration. Copy to .env for local use, or paste into the host's
# environment-variable settings. Every value here has a default that runs MicroVerse
# exactly as it has always run, so an empty environment is a working environment.
#
# Nothing in this file is a secret. Do not commit the filled-in version.

# --- where a job's bytes live ------------------------------------------------
# "local" (default) writes to data/jobs/<token>/, which is what a server with a disk
# should keep doing. "blob" stores them in Vercel Blob, for a host whose filesystem
# does not outlive the request.
MICROVERSE_STORAGE=local

# --- how an analysis is started ----------------------------------------------
# "inline" (default) runs it in Starlette's background threadpool. "queue" publishes
# the token to Vercel Queues, whose delivery invokes the worker route — required on a
# host that freezes the process once the response is sent.
MICROVERSE_JOBS=inline

# --- the job database ---------------------------------------------------------
# Defaults to SQLite beside the data directory. A host without a durable disk needs a
# networked database instead; any SQLAlchemy URL works.
#   Neon:  postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
# MICROVERSE_DB=

# --- secrets the host provides ------------------------------------------------
# Vercel sets these for you when the Blob store and Queues are attached to the
# project. They are listed here so the required set is visible in one place.
# BLOB_READ_WRITE_TOKEN=
# VERCEL_OIDC_TOKEN=

# Shared secret the worker route checks, so only the queue can start an analysis.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MICROVERSE_WORKER_SECRET=

# --- optional tuning ----------------------------------------------------------
# Absolute base URL of the deployment. Derived from VERCEL_URL when unset.
# MICROVERSE_BASE_URL=
# Seconds a signed download link stays valid (default 900).
# MICROVERSE_DOWNLOAD_TTL=900
# Seconds a browser has to finish uploading one file (default 1800).
# MICROVERSE_UPLOAD_TTL=1800
# Seconds an undelivered run request stays claimable (default 21600).
# MICROVERSE_QUEUE_TTL=21600
# Days results are kept — SPEC 16.5 says 90.
# MICROVERSE_RETENTION_DAYS=90
# Largest upload accepted, in bytes (default 67108864 = 64 MB).
# MICROVERSE_MAX_UPLOAD=67108864
# Concurrent analyses allowed. On a queue backend this is the consumer concurrency,
# which is global; on the inline backend it is per process.
# MICROVERSE_MAX_CONCURRENT=4
# The "Source" link in the header and footer.
# MICROVERSE_REPO=https://github.com/prince-raveled/STATA-Cluster
