{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "microverse": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "pyproject.toml",
      "buildCommand": "python examples/make_examples.py",
      "functions": {
        "app/main.py": {
          "maxDuration": 300,
          "excludeFiles": "{tests/**,docs/**,data/**,deploy/**,.venv/**,.github/**,blob/**,scratchpad/**,**/*.pyc,**/__pycache__/**}",
          "includeFiles": "examples/**"
        }
      }
    },
    "blob_upload": {
      "root": "blob",
      "entrypoint": "api/blob-upload.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/blob-upload",
      "destination": {
        "service": "blob_upload"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "microverse"
      }
    }
  ]
}
