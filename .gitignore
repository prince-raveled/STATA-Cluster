.venv/

# Local settings. .env.example says to copy it to .env and fill it in; the copy holds
# real credentials and must never be committed.
.env
.env.*
!.env.example

data/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
examples/*_abundance.tsv
examples/*_metadata.tsv
examples/*_taxonomy.tsv
examples/*_truth.json
.ruff_cache/
.venv310/
.claude/
*.log
.DS_Store
Thumbs.db

# Vercel CLI scratch state (dev.lock, local link). Never committed.
.vercel/

# The Blob signing service's dependencies, installed from blob/package-lock.json.
node_modules/

# setuptools build artefacts, from the host installing this project.
build/
*.egg-info/
